+import { useAppBackground, getAppBackgroundActions } from '../../../application/state/appBackgroundStore';
+import { useI18n } from '../../../application/i18n/I18nProvider';
+import { Button } from '../../ui/button';
+import { SectionHeader, SettingCard, SettingRow, Toggle } from '../settings-ui';
+
+export function AppBackgroundSettingsCard() {
+  const { t } = useI18n();
+  const { settings, imageUrl, busy, error } = useAppBackground();
+  const actions = getAppBackgroundActions();
+  return <section>
+    <SectionHeader anchorId="appearance-background" title={t('settings.appearance.background.title')} />
+    <SettingCard padded>
+      <p className="text-xs text-muted-foreground mb-3">{t('settings.appearance.background.description')}</p>
+      {imageUrl && <img src={imageUrl} alt={t('settings.appearance.background.preview')}
+        className="mb-3 h-32 w-full rounded-md object-cover" />}
+      <div className="flex gap-2 mb-3">
+        <Button size="sm" disabled={busy || !actions} onClick={() => void actions?.importImage()}>
+          {t('settings.appearance.background.choose')}
+        </Button>
+        <Button size="sm" variant="outline" disabled={busy || !settings.imageId || !actions}
+          onClick={() => void actions?.removeImage()}>{t('settings.appearance.background.remove')}</Button>
+      </div>
+      <SettingRow label={t('settings.appearance.background.enabled')}>
+        <Toggle checked={settings.enabled} disabled={busy || !settings.imageId}
+          ariaLabel={t('settings.appearance.background.enabled')}
+          onChange={(enabled) => actions?.update({ enabled })} />
+      </SettingRow>
+      <SettingRow label={t('settings.appearance.background.opacity')}>
+        <div className="flex items-center gap-2">
+          <input type="range" min={0} max={100} step={1} value={Math.round(settings.surfaceOpacity * 100)}
+            aria-label={t('settings.appearance.background.opacity')} disabled={busy || !settings.imageId}
+            onChange={(event) => actions?.update({ surfaceOpacity: Number(event.target.value) / 100 })} />
+          <span className="w-10 text-right text-xs tabular-nums">{Math.round(settings.surfaceOpacity * 100)}%</span>
+        </div>
+      </SettingRow>
+      {error && <p role="alert" className="mt-2 text-xs text-destructive">{t('settings.appearance.background.error')}</p>}
+    </SettingCard>
+  </section>;
+}
diff --git a/components/terminal/TerminalPaddingBackground.tsx b/components/terminal/TerminalPaddingBackground.tsx
new file mode 100644
--- /dev/null
+++ b/components/terminal/TerminalPaddingBackground.tsx
@@ -0,0 +1,76 @@
+import React, { useLayoutEffect, useRef } from 'react';
+
+/** Fill the terminal margins without adding another tint behind xterm's canvas.
+ * The fitted screen can be smaller than its host because of whole cells and
+ * the scrollbar, so CSS padding alone cannot describe the uncovered region.
+ * During a debounced fit it can also be wider than its clipping viewport.
+ */
+export function TerminalPaddingBackground({ top }: { top: number }) {
+  const ref = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    const layer = ref.current;
+    const host = layer?.parentElement;
+    if (!layer || !host) return;
+    let screen: HTMLElement | null = null;
+    const ancestors: HTMLElement[] = [];
+    const update = () => {
+      if (!screen) return;
+      const outer = layer.getBoundingClientRect();
+      const inner = screen.getBoundingClientRect();
+      let left = Math.max(inner.left, outer.left);
+      let right = Math.min(inner.right, outer.right);
+      let top = Math.max(inner.top, outer.top);
+      let bottom = Math.min(inner.bottom, outer.bottom);
+      // Sidebar expansion clips the old, wide screen before xterm refits.
+      // Only punch out pixels the canvas can actually paint; otherwise the
+      // old hole also removes the tint from the pane's outer right margin.
+      for (const element of ancestors) {
+        const style = getComputedStyle(element);
+        const bounds = element.getBoundingClientRect();
+        if (style.overflowX !== 'visible') {
+          left = Math.max(left, bounds.left);
+          right = Math.min(right, bounds.right);
+        }
+        if (style.overflowY !== 'visible') {
+          top = Math.max(top, bounds.top);
+          bottom = Math.min(bottom, bounds.bottom);
+        }
+      }
+      if (right <= left || bottom <= top) {
+        layer.style.clipPath = 'none';
+        return;
+      }
+      left -= outer.left;
+      right -= outer.left;
+      top -= outer.top;
+      bottom -= outer.top;
+      layer.style.clipPath = `polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ${left}px ${top}px, ${right}px ${top}px, ${right}px ${bottom}px, ${left}px ${bottom}px, ${left}px ${top}px)`;
+    };
+    // ResizeObserver runs before paint. Deferring this write to another frame
+    // leaves the old hole over the newly fitted screen during sidebar toggles.
+    // clip-path does not affect layout, so updating here cannot resize the host.
+    const resize = new ResizeObserver(update);
+    resize.observe(layer);
+    const attach = () => {
+      const next = host.querySelector<HTMLElement>('.xterm-screen');
+      if (!next) return;
+      screen = next;
+      resize.observe(screen);
+      for (let element = screen.parentElement; element && element !== host; element = element.parentElement) {
+        ancestors.push(element);
+        resize.observe(element);
+      }
+      mutation.disconnect();
+      update();
+    };
+    const mutation = new MutationObserver(attach);
+    mutation.observe(host, { childList: true, subtree: true });
+    attach();
+    return () => {
+      resize.disconnect();
+      mutation.disconnect();
+    };
+  }, [top]);
+
+  return <div ref={ref} className="terminal-padding-background absolute inset-x-0 bottom-0 pointer-events-none" style={{ top }} aria-hidden="true" />;
+}
diff --git a/components/terminal/appBackground.ts b/components/terminal/appBackground.ts
new file mode 100644
--- /dev/null
+++ b/components/terminal/appBackground.ts
@@ -0,0 +1,21 @@
+import { getAppBackgroundSnapshot } from '../../application/state/appBackgroundStore';
+import { isAppBackgroundWindow, resolveTerminalBackgroundColor } from '../../domain/appBackground';
+
+let colorContext: CanvasRenderingContext2D | null | undefined;
+
+/** Normalize named/browser-supported CSS colors using the browser's color parser. */
+export function resolveAppTerminalBackground(color: string): string {
+  const state = getAppBackgroundSnapshot();
+  if (!state.effectiveEnabled
+    || (typeof window !== 'undefined' && !isAppBackgroundWindow(window.location.hash))) return color;
+  let normalized = color;
+  if (typeof document !== 'undefined') {
+    colorContext ??= document.createElement('canvas').getContext('2d');
+    if (colorContext) {
+      colorContext.fillStyle = '#000000';
+      colorContext.fillStyle = color;
+      normalized = colorContext.fillStyle;
+    }
+  }
+  return resolveTerminalBackgroundColor(normalized, state);
+}
